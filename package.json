{
  "name": "phichai-school-global-directory",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:e2e": "vitest run apps/directory-web/tests/e2e",
    "test:integration": "vitest run tests/acceptance",
    "test:a11y": "vitest run tests/acceptance/accessibility.acceptance.test.ts",
    "bench:search": "node scripts/bench-search.mjs",
    "build:web": "node scripts/build-web.mjs",
    "verify": "pnpm test && pnpm test:integration && pnpm test:e2e && pnpm lint && pnpm typecheck && pnpm build:web && pnpm test:a11y && pnpm bench:search -- --dataset=approved-anonymized-fixture && pnpm audit --prod"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
